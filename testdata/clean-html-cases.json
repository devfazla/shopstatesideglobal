{
  "description": "Canonical HTML-to-Markdown test vectors shared by the Go, JavaScript, and Python implementations. Every implementation must produce `want` (after trimming a single trailing newline) for `in`.",
  "cases": [
    { "name": "empty", "in": "   ", "want": "" },
    { "name": "paragraph with bold", "in": "<p>Hello <b>world</b></p>", "want": "Hello **world**" },
    { "name": "strong", "in": "<p>Hi <strong>there</strong></p>", "want": "Hi **there**" },
    { "name": "heading", "in": "<h1>Title</h1>", "want": "# Title" },
    { "name": "heading level 3", "in": "<h3>Sub</h3>", "want": "### Sub" },
    { "name": "link", "in": "<a href=\"https://example.com\">Example</a>", "want": "[Example](https://example.com)" },
    { "name": "bare link collapses", "in": "<a href=\"https://example.com\">https://example.com</a>", "want": "https://example.com" },
    { "name": "unordered list", "in": "<ul><li>a</li><li>b</li></ul>", "want": "- a\n- b" },
    { "name": "ordered list", "in": "<ol><li>first</li><li>second</li></ol>", "want": "1. first\n2. second" },
    { "name": "italic and code", "in": "<em>hi</em> and <code>x=1</code>", "want": "_hi_ and `x=1`" },
    { "name": "entity decoding", "in": "<p>Tom &amp; Jerry &lt;3</p>", "want": "Tom & Jerry <3" },
    { "name": "script removed", "in": "<script>alert(1)</script><p>ok</p>", "want": "ok" },
    { "name": "image", "in": "<img src=\"/a.png\" alt=\"logo\">", "want": "![logo](/a.png)" },
    { "name": "block quote", "in": "<blockquote>quoted</blockquote>", "want": "> quoted" },
    { "name": "line break", "in": "one<br>two", "want": "one\ntwo" },
    { "name": "horizontal rule", "in": "a<hr>b", "want": "a\n---\nb" },
    { "name": "nested formatting in heading", "in": "<h2>A <b>bold</b> title</h2>", "want": "## A bold title" },
    { "name": "comment removed", "in": "<p>a<!-- note -->b</p>", "want": "ab" }
  ]
}
